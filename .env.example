# Copy to .env and fill in. Never commit .env.

# Postgres (docker-compose wires DATABASE_URL from these)
POSTGRES_DB=desk
POSTGRES_USER=desk
POSTGRES_PASSWORD=change-me

# Where the app listens on the host. Caddy in front for TLS; the app never faces the internet directly.
BIND_ADDR=127.0.0.1
APP_PORT=8010

# The XE node this instance reads from (payout-address checks, network badge). It never writes to it.
#   testnet: https://ldn.core.test.network
#   mainnet: set at Genesis
XE_NODE_URL=https://ldn.core.test.network

# Public URLs. One deployment, two front doors; the pair is the recommendation in docs/DESK_BRIEF.md §3.
#   staging:    https://desk.test.network  (set both hosts to it)
#   production: https://bounty.xe.network and https://support.xe.network
PUBLIC_BASE_URL=https://bounty.xe.network
DESK_BOUNTY_HOST=bounty.xe.network
DESK_SUPPORT_HOST=support.xe.network

# Passkeys. The RP id must be a registrable suffix of every host above so one passkey works on both.
#   staging: test.network    production: xe.network
WEBAUTHN_RP_ID=xe.network
WEBAUTHN_RP_NAME=XE Desk

# Config directory (tiers, areas, labels, copy registers). Mounted read-only in compose.
DESK_CONFIG_DIR=/app/config

# Service keyfile (encrypted with DESK_SIGNER_PASSPHRASE). Holds the log-signing key and the vault key. Create with: desk keys init
DESK_SIGNER_KEYFILE=/app/secrets/signer.json
DESK_SIGNER_PASSPHRASE=change-me-too

# Where private attachments are stored (encrypted). A compose volume.
DESK_BLOB_DIR=/app/blobs
# Attachment limits on the filing form.
DESK_MAX_ATTACHMENT_MB=10
DESK_MAX_ATTACHMENTS=5

# Reporter sign-in with GitHub: an OAuth App (github.com → Settings → Developer settings → OAuth Apps).
# Callback URL: https://bounty.xe.network/v1/reporter/auth/github/callback  (the bounty host, always).
# Empty: the GitHub button is hidden; email links and XE keys still work.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Discord. One application does both the support bot and "Continue with Discord" on the sign-in page.
# Bot: token from the Bot tab, Message Content intent on; invite with scopes bot+applications.commands.
# Sign-in: OAuth2 tab, redirect https://bounty.xe.network/v1/reporter/auth/discord/callback, client secret here.
# Ids: right-click → Copy ID with Developer Mode on. All empty: no bot, no button.
DISCORD_APP_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=0
DISCORD_SUPPORT_CHANNEL_ID=0
DISCORD_SUPPORT_ROLE_ID=0

# GitHub. A fine-grained token with issues:read/write and pull requests:read on the repos below.
# Leave the token empty to run without GitHub (triage import still works; nothing is mirrored).
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# The login the token belongs to; its comments are shown as team, not reporter.
GITHUB_BOT_LOGIN=
# Where the CTO's internal tickets live, for internal_ref links. {ref} is the number; "faucet#10" uses the faucet template.
# GITHUB_TOKEN must be able to read xeprotocol/core for the read-only sync (config/desk.yaml → internal).
INTERNAL_TRACKER_URL=https://github.com/xeprotocol/core/issues/{ref}
INTERNAL_TRACKER_FAUCET_URL=https://github.com/xeprotocol/faucet/issues/{ref}

# Outbound email for invites and magic links. Empty host: links are printed to the log / CLI instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=desk@xe.network

# Build metadata (set by the deploy script)
GIT_COMMIT=unknown

LOG_LEVEL=info
